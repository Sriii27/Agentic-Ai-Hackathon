# node_modules and everything else is intentionally tracked per request.
# Build output stays excluded -- it's 100% regenerated by `npm run dev` /
# `npm run build`, contributed nothing friends need, and its churn (esp. the
# turbopack dev cache) caused a dev-server crash and a GitHub 100MB push
# rejection in the same session this was set up.
/.next/
/dist/
/out/
src/widgets/.next/
src/widgets/dist/
src/widgets/out/

# GitHub hard-rejects any file over 100MB -- these regenerate via npm install.
**/@next/swc-*/*.node
