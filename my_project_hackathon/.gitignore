
.nitrostudio/

# Build output stays excluded -- 100% regenerated by nitrostack-cli build/dev,
# and its churn (esp. the widgets Next.js dev cache) caused problems when
# committed. node_modules is still tracked per request.
/dist/
src/widgets/.next/
src/widgets/out/

# GitHub hard-rejects files over 100MB -- these regenerate via npm install.
**/@next/swc-*/*.node
